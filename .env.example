# ---- Provider Auto-Detection ----
# The system auto-detects which provider to use based on which key is present:
#   sk-... key  → OpenAI  (gpt-4o / gpt-4o-mini)
#   gsk-... key → Groq    (gpt-oss-120b / gpt-oss-20b)
#   Azure keys  → Azure OpenAI
# Set PROVIDER explicitly to override: openai, groq, or azure
# PROVIDER=auto

# ---- API Keys (fill at least one) ----
OPENAI_API_KEY=sk-your-key-here
# GROQ_API_KEY=gsk-your-groq-key-here

# ---- Azure OpenAI (optional) ----
# AZURE_OPENAI_API_KEY=your-azure-key
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_VERSION=2024-08-01-preview

# ---- Model Overrides (optional — defaults are picked per provider) ----
# PRIMARY_MODEL=gpt-4o
# BASELINE_MODEL=gpt-4o-mini
# JUDGE_MODEL=gpt-4o

# ---- Application ----
LOG_LEVEL=INFO
